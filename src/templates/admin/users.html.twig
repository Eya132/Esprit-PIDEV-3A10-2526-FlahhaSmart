{# templates/admin/users.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Gestion des Utilisateurs{% endblock %}
{% block page_title %}Gestion des Utilisateurs{% endblock %}

{% block body %}

{# ── Cartes Statistiques ── #}
<div class="row g-3 mb-4">
    <div class="col-md-6 col-lg-2">
        <div class="stat-card text-center" style="background: linear-gradient(135deg, #1a3c34, #2e7d52);">
            <div class="fs-2 fw-bold">{{ stats.total }}</div>
            <div class="small opacity-75">Total</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-2">
        <div class="stat-card text-center" style="background: linear-gradient(135deg, #c05000, #e07020);">
            <div class="fs-2 fw-bold">{{ stats.admins }}</div>
            <div class="small opacity-75">Admins</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-2">
        <div class="stat-card text-center" style="background: linear-gradient(135deg, #1a6e35, #3aad74);">
            <div class="fs-2 fw-bold">{{ stats.agriculteurs }}</div>
            <div class="small opacity-75">Agriculteurs</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-2">
        <div class="stat-card text-center" style="background: linear-gradient(135deg, #1a4fa0, #2196f3);">
            <div class="fs-2 fw-bold">{{ stats.clients }}</div>
            <div class="small opacity-75">Clients</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-2">
        <div class="stat-card text-center" style="background: linear-gradient(135deg, #2e7d52, #66bb6a);">
            <div class="fs-2 fw-bold">{{ stats.actifs }}</div>
            <div class="small opacity-75">Actifs</div>
        </div>
    </div>
    <div class="col-md-6 col-lg-2">
        <div class="stat-card text-center" style="background: linear-gradient(135deg, #c62828, #ef5350);">
            <div class="fs-2 fw-bold">{{ stats.inactifs }}</div>
            <div class="small opacity-75">Inactifs</div>
        </div>
    </div>
</div>

{# ── Formulaire de recherche et filtres ── #}
<div class="card mb-4">
    <div class="card-body">
        <form method="get" class="row g-3">
            <div class="col-md-4">
                <label class="form-label">Recherche</label>
                <input type="text" name="search" value="{{ search }}" class="form-control" 
                       placeholder="Nom, prénom ou email...">
            </div>
            <div class="col-md-3">
                <label class="form-label">Rôle</label>
                <select name="role" class="form-select">
                    <option value="">Tous les rôles</option>
                    <option value="ADMINISTRATEUR" {{ role == 'ADMINISTRATEUR' ? 'selected' : '' }}>Admin</option>
                    <option value="AGRICULTEUR" {{ role == 'AGRICULTEUR' ? 'selected' : '' }}>Agriculteur</option>
                    <option value="CLIENT" {{ role == 'CLIENT' ? 'selected' : '' }}>Client</option>
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label">Statut</label>
                <select name="status" class="form-select">
                    <option value="">Tous</option>
                    <option value="actif" {{ status == 'actif' ? 'selected' : '' }}>Actifs</option>
                    <option value="inactif" {{ status == 'inactif' ? 'selected' : '' }}>Inactifs</option>
                </select>
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search"></i> Filtrer
                </button>
            </div>
        </form>
    </div>
</div>

{# ── Bouton Ajouter ── #}
<div class="mb-3 text-end">
    <a href="{{ path('admin_user_new') }}" class="btn btn-success">
        <i class="bi bi-person-plus"></i> Ajouter un utilisateur
    </a>
</div>

{# ── Tableau des utilisateurs ── #}
<div class="card">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover mb-0">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Nom complet</th>
                        <th>Email</th>
                        <th>Téléphone</th>
                        <th>Ville</th>
                        <th>Rôle</th>
                        <th>Statut</th>
                        <th>Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% for u in users %}
                    <tr>
                        <td class="text-muted">{{ u.id }}</td>
                        <td>
                            <strong>{{ u.prenom }} {{ u.nom }}</strong>
                        </td>
                        <td>{{ u.email }}</td>
                        <td>{{ u.telephone ?? '—' }}</td>
                        <td>{{ u.ville ?? '—' }}</td>
                        <td>
                            <span class="badge badge-{{ u.role }}">
                                {{ u.role }}
                            </span>
                        </td>
                        <td>
                            {% if u.actif %}
                                <span class="badge bg-success">Actif</span>
                            {% else %}
                                <span class="badge bg-danger">Inactif</span>
                            {% endif %}
                        </td>
                        <td class="text-muted small">{{ u.dateCreation|date('d/m/Y') }}</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <a href="{{ path('admin_user_edit', {id: u.id}) }}" 
                                   class="btn btn-outline-primary" title="Modifier">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form method="post" action="{{ path('admin_user_toggle', {id: u.id}) }}" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('toggle' ~ u.id) }}">
                                    <button type="submit" class="btn btn-outline-warning" 
                                            title="{{ u.actif ? 'Désactiver' : 'Activer' }}">
                                        <i class="bi {{ u.actif ? 'bi-toggle-on' : 'bi-toggle-off' }}"></i>
                                    </button>
                                </form>
                                {% if u.email != app.user.email %}
                                <form method="post" action="{{ path('admin_user_delete', {id: u.id}) }}" 
                                      onsubmit="return confirm('Supprimer {{ u.prenom }} {{ u.nom }} ?')" class="d-inline">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ u.id) }}">
                                    <button type="submit" class="btn btn-outline-danger" title="Supprimer">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </form>
                                {% endif %}
                            </div>
                        </td>
                    </tr>
                    {% else %}
                    <tr>
                        <td colspan="9" class="text-center text-muted py-4">
                            <i class="bi bi-people fs-2 d-block mb-2"></i>
                            Aucun utilisateur trouvé
                        </td>
                    </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>

{# ── Pagination (optionnelle) ── #}
{% if users|length > 0 %}
<div class="mt-3 text-muted small">
    Affichage de {{ users|length }} utilisateur(s)
</div>
{% endif %}

{% endblock %}